{
  "version": "1.0.0",
  "title": "Commercial Zero-Bureaucracy KPI Framework",
  "dimensions": ["speed", "effort", "automation", "duplication", "friction"],
  "kpis": [
    {"id": "cycle_time", "name": "Decision Cycle Time", "dimension": "speed", "unit": "hours",
     "formula": "median(hours from request to decision)", "direction": "lower", "weight": 1.0,
     "benchmark": {"best": 1, "worst": 72}},
    {"id": "lead_time", "name": "Change Lead Time", "dimension": "speed", "unit": "hours",
     "formula": "median(hours from approval to production)", "direction": "lower", "weight": 1.0,
     "benchmark": {"best": 2, "worst": 240}},
    {"id": "throughput", "name": "Weekly Throughput", "dimension": "speed", "unit": "items/week",
     "formula": "count(items shipped per week)", "direction": "higher", "weight": 0.8,
     "benchmark": {"best": 50, "worst": 2}},
    {"id": "steps_per_task", "name": "Steps Per Task", "dimension": "effort", "unit": "steps",
     "formula": "mean(number of human steps per completed task)", "direction": "lower", "weight": 1.0,
     "benchmark": {"best": 1, "worst": 20}},
    {"id": "touch_time", "name": "Manual Touch Time", "dimension": "effort", "unit": "minutes",
     "formula": "mean(human minutes per completed task)", "direction": "lower", "weight": 1.0,
     "benchmark": {"best": 1, "worst": 120}},
    {"id": "rework_rate", "name": "Rework Rate", "dimension": "effort", "unit": "ratio",
     "formula": "reopened / total tasks", "direction": "lower", "weight": 0.7,
     "benchmark": {"best": 0.01, "worst": 0.5}},
    {"id": "automation_ratio", "name": "Automation Ratio", "dimension": "automation", "unit": "ratio",
     "formula": "automated steps / total steps", "direction": "higher", "weight": 1.0,
     "benchmark": {"best": 0.95, "worst": 0.1}},
    {"id": "straight_through", "name": "Straight-Through Processing", "dimension": "automation", "unit": "ratio",
     "formula": "tasks completed with zero human touch / total", "direction": "higher", "weight": 1.0,
     "benchmark": {"best": 0.9, "worst": 0.0}},
    {"id": "self_service", "name": "Self-Service Coverage", "dimension": "automation", "unit": "ratio",
     "formula": "requests resolved without staff / total", "direction": "higher", "weight": 0.8,
     "benchmark": {"best": 0.9, "worst": 0.1}},
    {"id": "duplicate_forms", "name": "Duplicate Data Entry", "dimension": "duplication", "unit": "count",
     "formula": "times the same field is entered per workflow", "direction": "lower", "weight": 1.0,
     "benchmark": {"best": 1, "worst": 6}},
    {"id": "approval_layers", "name": "Approval Layers", "dimension": "duplication", "unit": "layers",
     "formula": "count(distinct sign-offs per task)", "direction": "lower", "weight": 1.0,
     "benchmark": {"best": 0, "worst": 5}},
    {"id": "handoff_friction", "name": "Handoff Friction", "dimension": "friction", "unit": "count",
     "formula": "count(handoffs where context is lost or re-explained)", "direction": "lower", "weight": 1.0,
     "benchmark": {"best": 0, "worst": 8}}
  ],
  "dimension_weights": {"speed": 1.0, "effort": 1.0, "automation": 1.0, "duplication": 1.0, "friction": 1.0}
}
